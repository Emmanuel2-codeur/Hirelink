{
  "name": "hirelink",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["web", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w backend"
  },
  "devDependencies": { "concurrently": "^9.0.1" }
}
